/* --- Console Filtering --- */
(function() {
    const originalLog = console.log;
    const originalInfo = console.info;
    const filterLogs = (args, originalFn) => {
        const message = args[0];
        if (typeof message === 'string') {
            const isSwfLoading = message.includes('.swf') || message.includes('Loading');
            const isRuffleInit = message.includes('Ruffle instance') || 
                                 message.includes('WebAssembly extensions') || 
                                 message.includes('Used renderer');
            if (isSwfLoading || isRuffleInit) return;
        }
        originalFn.apply(console, args);
    };
    console.log = function() { filterLogs(arguments, originalLog); };
    console.info = function() { filterLogs(arguments, originalInfo); };
})();

/* --- Gamepad Logic --- */
const MAPPING = {
    "LEFT":   { key: "ArrowLeft",  keyCode: 37, code: "ArrowLeft" },
    "RIGHT":  { key: "ArrowRight", keyCode: 39, code: "ArrowRight" },
    "UP":     { key: "ArrowUp",    keyCode: 38, code: "ArrowUp" },
    "DOWN":   { key: "ArrowDown",  keyCode: 40, code: "ArrowDown" },
    "BTN_X":  { key: "x",          keyCode: 88, code: "KeyX" },
    "BTN_C":  { key: "c",          keyCode: 67, code: "KeyC" },
    "START":  { key: " ",          keyCode: 32, code: "Space" },
    "SELECT": { key: "Escape",     keyCode: 27, code: "Escape" }
};

const THRESHOLD = 0.5; 
let activeInputs = {};

function monitorGamepad() {
    const gp = navigator.getGamepads()[0];
    if (!gp) {
        Object.keys(activeInputs).forEach(name => {
            if (activeInputs[name]) releaseKey(name);
        });
        return requestAnimationFrame(monitorGamepad);
    }
    const inputs = [
        { name: "LEFT",   val: gp.axes[0] < -THRESHOLD || gp.buttons[14]?.pressed },
        { name: "RIGHT",  val: gp.axes[0] > THRESHOLD  || gp.buttons[15]?.pressed },
        { name: "UP",     val: gp.axes[1] < -THRESHOLD || gp.buttons[12]?.pressed },
        { name: "DOWN",   val: gp.axes[1] > THRESHOLD  || gp.buttons[13]?.pressed },
        { name: "BTN_X",  val: gp.buttons[0]?.pressed || gp.buttons[3]?.pressed },
        { name: "BTN_C",  val: gp.buttons[1]?.pressed || gp.buttons[2]?.pressed },
        { name: "START",  val: gp.buttons[9]?.pressed },
        { name: "SELECT", val: gp.buttons[8]?.pressed }
    ];
    inputs.forEach(input => {
        if (input.val && !activeInputs[input.name]) pressKey(input.name);
        else if (!input.val && activeInputs[input.name]) releaseKey(input.name);
    });
    requestAnimationFrame(monitorGamepad);
}

function pressKey(name) {
    const data = MAPPING[name];
    if (data) { dispatch("keydown", data); activeInputs[name] = true; }
}

function releaseKey(name) {
    const data = MAPPING[name];
    if (data) { dispatch("keyup", data); activeInputs[name] = false; }
}

function dispatch(type, data) {
    window.dispatchEvent(new KeyboardEvent(type, {
        key: data.key, keyCode: data.keyCode, code: data.code,
        which: data.keyCode, bubbles: true, cancelable: true
    }));
}

monitorGamepad();